# everything-finance secrets — template. Copy this file to a .env the plugin loads:
#
#   cp .env.example .env                 # next to the plugin (the default)
#   cp .env.example "$PLUGIN_DATA/.env"  # persistent, survives updates (read-only installs)
#
# bin/load-env.sh searches those two, first found wins. Every key is OPTIONAL: a missing
# one degrades only the source that needs it to a labelled gap — public data still works.
# Never commit a filled-in copy (.gitignore already excludes .env / *.env).

# Telegram briefs (daily-brief, deep-analysis hook).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# screener.in authenticated screens (public pages work without these).
# sessionid cookie + csrftoken cookie/X-CSRFToken header. They expire.
SCREENER_SESSION_ID=
SCREENER_CSRF_TOKEN=

# TradingView saved/personal screens only (public screener covers the seed filters).
# Copy from a logged-in browser: DevTools -> Application -> Cookies. They expire.
TRADINGVIEW_SESSIONID=
TRADINGVIEW_SESSIONID_SIGN=
