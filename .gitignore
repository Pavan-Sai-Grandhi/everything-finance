# Runtime outputs — skills write these to the session cwd, never commit them
artifacts/
*.log

# Local source material distilled into skills (kept for provenance, not shipped)
.refs/

# Python — caches/bytecode from running the bundled scripts & tests
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.venv/
venv/

# OS / editor cruft
.DS_Store
*.swp
.idea/
.vscode/

# Local secrets never live in the repo — belt and braces. The template ships; a
# filled-in .env (in the plugin dir or $PLUGIN_DATA) never does.
.env
*.env
!.env.example

# Working notes and vendored design material stay local — the dot prefix marks
# a docs/ subtree that never ships. Anything else under docs/ is shippable.
docs/.local/
docs/.superpowers/

# Lavish Editor artifacts (local review surfaces)
.lavish/
